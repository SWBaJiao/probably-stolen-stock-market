<Project>
  <Target Name="ValidateMelonReferences" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(MelonLoaderAssembly)' == '' or !Exists('$(MelonLoaderAssembly)')"
           Text="找不到 MelonLoader.dll：$(MelonLoaderAssembly)。请先在目标游戏安装 MelonLoader，或在 Game.local.props 配置 MelonLoaderAssembly。" />
  </Target>

  <Target Name="ValidateGameInterop" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(UseGameInterop)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RequiredInterop Include="$(Il2CppAssembliesDirectory)/Il2Cppmscorlib.dll;$(MelonRuntimeDirectory)/Il2CppInterop.Common.dll;$(MelonRuntimeDirectory)/Il2CppInterop.Runtime.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(Il2CppAssembliesDirectory)/Il2CppAssembly-CSharp.dll') and !Exists('$(Il2CppAssembliesDirectory)/Assembly-CSharp.dll')"
           Text="找不到游戏代理程序集。请用 MelonLoader 成功启动一次目标游戏，生成 MelonLoader/Il2CppAssemblies，然后检查 Il2CppAssembliesDirectory。" />
    <Error Condition="!Exists('%(_RequiredInterop.Identity)')"
           Text="缺少 IL2CPP 互操作引用：%(_RequiredInterop.Identity)。请使用当前游戏及 MelonLoader 生成的对应文件。" />
  </Target>

  <Target Name="DeployMelonMod" AfterTargets="Build"
          Condition="'$(DeployOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(GameDirectory)' == '' or !Exists('$(GameDirectory)')"
           Text="自动部署需要存在的 GameDirectory。" />
    <Error Condition="!Exists('$(GameDirectory)/MelonLoader/net6/MelonLoader.dll')"
           Text="目标游戏尚未安装 .NET 6 MelonLoader，无法部署：$(GameDirectory)。编译引用路径不会代替游戏侧的加载器安装。" />
    <Error Condition="'$(AssemblyName)' == '' or '$(TargetPath)' == '' or !Exists('$(TargetPath)')"
           Text="找不到编译输出：$(TargetPath)。请先成功构建模组。" />
    <PropertyGroup>
      <ModDeployDirectory>$(GameDirectory)/Mods</ModDeployDirectory>
      <ModAssetDeployDirectory>$(GameDirectory)/UserData/$(AssemblyName)/Assets</ModAssetDeployDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_ModAssets Include="$(ModAssetsDirectory)/**/*"
                  Exclude="$(ModAssetsDirectory)/**/.gitkeep;$(ModAssetsDirectory)/**/.DS_Store" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModAssets)"
          DestinationFiles="@(_ModAssets->'$(ModAssetDeployDirectory)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModDeployDirectory)"
          Condition="'$(DeployDebugSymbols)' == 'true' and Exists('$(TargetDir)$(TargetName).pdb')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="MelonLoader 模组已部署到：$(ModDeployDirectory)/$(TargetFileName)；资源目录：$(ModAssetDeployDirectory)" />
  </Target>
</Project>
