<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="build/NativeDevelopment.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>ProbablyStolenStockMarket</AssemblyName>
    <RootNamespace>ProbablyStolenStockMarket</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="ProbablyStolenStockMarket.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- 仅引用正式版随游戏提供的程序集，分发时不复制游戏或框架 DLL。 -->
  <ItemGroup>
    <Reference Include="$(ManagedDirectory)/Assembly-CSharp.dll;$(ManagedDirectory)/Assembly-CSharp-firstpass.dll;$(ManagedDirectory)/0Harmony.dll;$(ManagedDirectory)/Newtonsoft.Json.dll;$(ManagedDirectory)/Unity*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Import Project="build/NativeDevelopment.targets" />
</Project>
